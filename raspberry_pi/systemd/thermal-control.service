[Unit]
Description=NN-MPC Thermal Control MQTT Service
After=network-online.target mosquitto.service influxdb.service
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Desktop/test_final
Environment=PYTHONIOENCODING=utf-8
ExecStart=/usr/bin/python3 /home/pi/Desktop/test_final/mqtt.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
